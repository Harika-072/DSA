import java.util.*;
import java.math.*;
class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc=new Scanner(System.in);
		int t=sc.nextInt();
		while(t-->0){
		    String s=sc.next();
		    BigInteger n=new BigInteger(s);
		    n=n.add(BigInteger.ONE);
		    System.out.println(n.toString());
		}

	}
}
