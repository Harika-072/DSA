import java.util.Scanner;

class Main{
    public static void main(String args[]){
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        while(t -->0){
            long n=sc.nextLong();
            System.out.println(bincount(n));
        }
    }
    static int bincount(long n){
        if(n == 0 || n == 1) return 1;
        return 1+bincount(n/2);
    }
}
