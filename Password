import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc=new Scanner(System.in);
		if(!sc.hasNextInt()) return;
		int t=sc.nextInt();
		while(t-->0){
		    String s=sc.next();
		    boolean hasLower=false;
		    boolean hasUpperstrict=false;
		    boolean hasDigitstrict=false;
		    boolean hasSpecialstrict=false;
		    if(s.length() <10){
		        System.out.println("NO");
		        continue;
		    }
		    for(int i=0;i<s.length();i++){
		        char ch =s.charAt(i);
		        if(ch >= 'a' && ch <='z'){
		            hasLower =true;
		        }
		        if(i >0 && i<s.length()-1){
		            if(ch >='A' && ch <='Z'){
		                hasUpperstrict = true;
		            }else if(ch >= '0' && ch <='9'){
		                hasDigitstrict = true;
		            } else if(ch == '@' || ch == '#'|| ch == '%' || ch == '&' || ch == '?'){
		                hasSpecialstrict = true;
		            }
		        }
		    }
		    if(hasLower && hasUpperstrict && hasDigitstrict && hasSpecialstrict){
		        System.out.println("YES");
		    } else {
		        System.out.println("NO");
		    }
		}
	}
}
