   public static int maxProductSubarray(int[] arr) {
       // write code here...
       int pref=1,suff=1,maxp=Integer.MIN_VALUE;
       for(int i=0;i<arr.length;i++){
           if(pref==0) pref=1;
           if(suff==0) suff=1;
           pref=pref*arr[i];
           suff=suff*arr[arr.length-1-i];
           maxp=Math.max(maxp,Math.max(pref,suff));
       }
       return maxp;
   }
